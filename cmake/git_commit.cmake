# git_commit.cmake: writes the current git commit into a header, nanobook_git.hpp.
#
# What it does: Runs `git describe --always --dirty --abbrev=12` in the source tree and writes
#   `#define NANOBOOK_GIT_COMMIT "<commit>"` to OUT, e.g. "51e4122a0c3d" or "51e4122a0c3d-dirty"
#   when tracked files have uncommitted changes. "unknown" if git or the repository isn't there.
#
# Why it exists: Every published latency number states the commit it came from (plan rule 19).
#   Reading the commit only when CMake configures would go stale after the next commit, so
#   CMakeLists.txt runs this script at configure time AND on every build.
#
# How it works: Script mode (cmake -DSRC=... -DOUT=... -P git_commit.cmake). The header is only
#   rewritten when its text changes, so an unchanged commit doesn't make anything rebuild.

execute_process(
    COMMAND git describe --always --dirty --abbrev=12
    WORKING_DIRECTORY "${SRC}"
    OUTPUT_VARIABLE commit
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE result
    ERROR_QUIET)
if(NOT result EQUAL 0 OR commit STREQUAL "")
    set(commit "unknown")
endif()

set(content "// Generated by cmake/git_commit.cmake on every build. Do not edit.\n#pragma once\n#define NANOBOOK_GIT_COMMIT \"${commit}\"\n")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUT}" "${content}")
endif()

# .gitignore: files git never tracks.
#
# What it does: Build output, reproduce.sh's results, the Python environment, editor indexes, profiler output and market
#   data files (too big for git, and not ours to republish).

# Build output
build/

# scripts/reproduce.sh output (a stranger's own results)
/repro/
compile_commands.json

# Personal presets (e.g. -march=native)
CMakeUserPresets.json

# clangd index
.cache/

# Windows "downloaded from internet" metadata created when copying files into WSL
*:Zone.Identifier

# Python (scripts/)
__pycache__/
*.pyc
.venv/

# perf / profiling output
perf.data
perf.data.old

# Market data (e.g. Nasdaq ITCH days, several GB each; docs/itch-design.md §2). The leading /
# limits it to the top folder: without it, docs/data/ (where results are kept) is ignored too.
/data/

+namespace {
+
+// Writes down, in order, every prefetch offer ('p' + type + length) and every delivery ('o').
+struct PrefetchLog {
+    std::vector<std::string> events;
+    void prefetch(const std::byte *m, std::size_t length) {
+        events.push_back(std::string{"p"} + read_char(m) + std::to_string(length));
+    }
+    template <typename Message> void on(const Message & /*message*/) {
+        events.emplace_back("o");
+    }
+    void on_skipped(char /*type*/) {
+        events.emplace_back("o");
+    }
+};
+
+// Each message's type and length, walking the buffer independently of parse().
+std::vector<std::string> types_and_lengths(std::span<const std::byte> day) {
+    std::vector<std::string> out;
+    for (std::size_t pos = 0; pos + kLengthPrefix <= day.size();) {
+        const auto length = read_be<std::uint16_t>(day.data() + pos);
+        if (pos + kLengthPrefix + length > day.size()) {
+            break;
+        }
+        out.push_back(std::string{read_char(day.data() + pos + kLengthPrefix)} +
+                      std::to_string(length));
+        pos += kLengthPrefix + length;
+    }
+    return out;
+}
+
+} // namespace
+
+TEST(ItchParse, OffersEachNextMessageForPrefetchingBeforeDeliveringTheCurrentOne) {
+    const std::vector<std::byte> day = golden::golden_day();
+    const std::vector<std::string> messages = types_and_lengths(day);
+    PrefetchLog log;
+    ASSERT_TRUE(parse(day, log).has_value());
+    // Expected: p(message 2) o p(message 3) o ... p(message n) o o (the last has no next one).
+    std::vector<std::string> expected;
+    for (std::size_t i = 0; i < messages.size(); ++i) {
+        if (i + 1 < messages.size()) {
+            expected.push_back("p" + messages[i + 1]);
+        }
+        expected.emplace_back("o");
+    }
+    EXPECT_EQ(log.events, expected);
+}
+
+TEST(ItchParse, NeverOffersAnIncompleteNextMessage) {
+    std::vector<std::byte> day = golden::golden_day();
+    const std::size_t whole = day.size();
+    Writer next;
+    next.add_order(AddOrder{.locate = 1,
+                            .timestamp = 99,
+                            .order_ref = 12'345,
+                            .side = 'B',
+                            .shares = 100,
+                            .stock = golden::kAaa,
+                            .price = 1'000'000});
+    day.insert(day.end(), next.bytes().begin(), next.bytes().end() - 1); // one byte short
+    PrefetchLog log;
+    const auto parsed = parse(day, log);
+    ASSERT_TRUE(parsed.has_value());
+    EXPECT_EQ(*parsed, whole); // stops before the incomplete add
+    ASSERT_FALSE(log.events.empty());
+    EXPECT_EQ(log.events.back(), "o"); // the last message delivered had nothing offered after it
+    EXPECT_EQ(std::ranges::count_if(log.events, [](const std::string &e) { return e[0] == 'p'; }),
+              static_cast<std::ptrdiff_t>(types_and_lengths(day).size()) - 1);
+}

+ template <typename Ring, typename T>
+ std::uint64_t push_waiting(Ring &ring, const T &item, bool spin_only) {
+     std::uint64_t failed = 0;
+     while (!ring.try_push(item)) {
+-        wait_once(failed++, spin_only);

diff --git a/support/huge_page_arena.hpp b/support/huge_page_arena.hpp
new file mode 100644
index 0000000..1a45845
--- /dev/null
+++ b/support/huge_page_arena.hpp
@@ -0,0 +1,179 @@
+/*
+ * huge_page_arena.hpp: one start-up region on 2 MiB pages that the books' arrays are built in.
+ *
+ * What it does: HugePageArena maps one region, aligned to 2 MiB, asks the kernel to back it with
+ *   2 MiB "huge" pages, touches every page, and hands its bytes out through a standard
+ *   std::pmr::memory_resource. DefaultResourceScope makes that resource the default while the
+ *   books are built, so their std::pmr::vectors (order pool, id table, levels) take their memory
+ *   from it. build_books() does both, sized by arena_bytes() from the books' own numbers.
+ *
+ * Why it exists: Optimise design E6. The CPU translates every address through a small cache of
+ *   page translations (the TLB). The real day's books take about 400 MB: about 100,000 pages of
+ *   4 KiB, far more than the TLB holds, so many messages wait for a page-table walk. On 2 MiB
+ *   pages it is about 200. Tried first with glibc's switch (GLIBC_TUNABLES=glibc.malloc.hugetlb=1):
+ *   4.8% more throughput and p99 7.6% better. This arena makes it part of the program.
+ *
+ * How it works:
+ *   - mmap the size rounded up to 2 MiB, plus 2 MiB of slack, and start at the first 2 MiB
+ *     boundary inside it: a huge page must start on one.
+ *   - madvise(MADV_HUGEPAGE): this kernel gives huge pages only to regions that ask
+ *     (transparent_hugepage = madvise). If it refuses, the pages are normal ones; huge_bytes()
+ *     reports how much really landed on huge pages (the AnonHugePages count grows by that much).
+ *   - One write per 4 KiB page now, at start-up (rule 1), so no page is first touched while
+ *     trading: this also does what E2's PrefaultAllocator did.
+ *   - std::pmr::monotonic_buffer_resource hands out the bytes in order and frees nothing until
+ *     the arena goes: the books live as long as it does. Its upstream is null_memory_resource, so
+ *     a wrong size throws std::bad_alloc instead of quietly falling back to normal pages.
+ *
+ * Data structures: the mapping (base, length, aligned start, usable size) and the monotonic
+ *   resource on top of it.
+ *
+ * Trade-offs: Linux only, tool code. The whole region is resident from the start. The arena must
+ *   outlive everything built in it. DefaultResourceScope changes a process-wide default, so only
+ *   the thread building the books may run while it is active.
+ */
+
+#pragma once
+
+#include <sys/mman.h>
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <fstream>
+#include <memory_resource>
+#include <new>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "nanobook/core/types.hpp"
+#include "nanobook/fast/fast_book.hpp"
+
+namespace nanobook::support {
+
+inline constexpr std::size_t kHugePage = std::size_t{2} << 20U; // 2 MiB
+inline constexpr std::size_t kPage = 4096;
+
+// This process's memory on transparent huge pages, in bytes (0 if unknown).
+inline std::uint64_t anon_huge_bytes() {
+    std::ifstream rollup{"/proc/self/smaps_rollup"};
+    std::string key;
+    std::uint64_t kilobytes = 0;
+    while (rollup >> key) {
+        if (key == "AnonHugePages:" && rollup >> kilobytes) {
+            return kilobytes * 1024;
+        }
+    }
+    return 0;
+}
+
+class HugePageArena {
+public:
+    explicit HugePageArena(std::size_t bytes)
+        : mapping_(map(bytes)),
+          resource_(mapping_.start, mapping_.size, std::pmr::null_memory_resource()) {
+        const std::uint64_t before = anon_huge_bytes();
+        volatile auto *page =
+            static_cast<unsigned char *>(mapping_.start); // writes can't be dropped
+        for (std::size_t i = 0; i < mapping_.size; i += kPage) {
+            page[i] = 0;
+        }
+        huge_bytes_ = anon_huge_bytes() - before;
+    }
+    HugePageArena(const HugePageArena &) = delete;
+    HugePageArena &operator=(const HugePageArena &) = delete;
+    HugePageArena(HugePageArena &&) = delete;
+    HugePageArena &operator=(HugePageArena &&) = delete;
+    ~HugePageArena() {
+        munmap(mapping_.base, mapping_.length);
+    }
+
+    [[nodiscard]] std::pmr::memory_resource *resource() {
+        return &resource_;
+    }
+    // Usable bytes: the request rounded up to 2 MiB.
+    [[nodiscard]] std::size_t size() const {
+        return mapping_.size;
+    }
+    // How many of them the kernel backed with 2 MiB pages.
+    [[nodiscard]] std::uint64_t huge_bytes() const {
+        return huge_bytes_;
+    }
+    [[nodiscard]] bool contains(const void *p) const {
+        const auto *start = static_cast<const unsigned char *>(mapping_.start);
+        const auto *byte = static_cast<const unsigned char *>(p);
+        return byte >= start && byte < start + mapping_.size;
+    }
+
+private:
+    struct Mapping {
+        void *base{};
+        std::size_t length{};
+        void *start{}; // the first 2 MiB boundary in [base, base + length)
+        std::size_t size{};
+    };
+
+    static Mapping map(std::size_t bytes) {
+        Mapping m;
+        m.size = (std::max<std::size_t>(bytes, 1) + kHugePage - 1) / kHugePage * kHugePage;
+        m.length = m.size + kHugePage; // room to move the start to a 2 MiB boundary
+        m.base =
+            mmap(nullptr, m.length, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+        if (m.base == MAP_FAILED) {
+            throw std::bad_alloc{};
+        }
+        const auto address = reinterpret_cast<std::uintptr_t>(m.base); // NOLINT: address maths
+        const std::uintptr_t aligned = (address + kHugePage - 1) & ~(kHugePage - 1);
+        m.start = static_cast<unsigned char *>(m.base) + (aligned - address);
+        madvise(m.start, m.size, MADV_HUGEPAGE); // a refusal leaves normal pages: huge_bytes() says
+        return m;
+    }
+
+    Mapping mapping_;
+    std::pmr::monotonic_buffer_resource resource_;
+    std::uint64_t huge_bytes_{};
+};
+
+// Makes `resource` the default memory resource until the end of the scope.
+class DefaultResourceScope {
+public:
+    explicit DefaultResourceScope(std::pmr::memory_resource *resource)
+        : previous_(std::pmr::set_default_resource(resource)) {
+    }
+    DefaultResourceScope(const DefaultResourceScope &) = delete;
+    DefaultResourceScope &operator=(const DefaultResourceScope &) = delete;
+    DefaultResourceScope(DefaultResourceScope &&) = delete;
+    DefaultResourceScope &operator=(DefaultResourceScope &&) = delete;
+    ~DefaultResourceScope() {
+        std::pmr::set_default_resource(previous_);
+    }
+
+private:
+    std::pmr::memory_resource *previous_;
+};
+
+// Bytes for one FastBook per config: the arrays themselves, plus up to 64 bytes of alignment per
+// array (the monotonic resource aligns each one; 4 arrays per book).
+inline std::size_t arena_bytes(const std::vector<BookConfig> &configs) {
+    std::size_t total = 0;
+    for (const BookConfig &config : configs) {
+        total += FastBook::arena_bytes(config) + (std::size_t{4} * 64);
+    }
+    return total;
+}
+
+// "412 MB arena, 412 MB of it on 2 MiB pages": for the timed tools' reports.
+inline std::string arena_text(const HugePageArena &arena) {
+    return std::to_string(arena.size() >> 20U) + " MB arena, " +
+           std::to_string(arena.huge_bytes() >> 20U) + " MB of it on 2 MiB pages";
+}
+
+// Builds a Builder (a BookBuilder<FastBook>) with its books' arrays in `arena`.
+template <typename Builder, typename... Args>
+Builder build_books(HugePageArena &arena, Args &&...args) {
+    const DefaultResourceScope scope{arena.resource()};
+    return Builder{std::forward<Args>(args)...};
+}
+
+} // namespace nanobook::support
diff --git a/tests/test_huge_page_arena.cpp b/tests/test_huge_page_arena.cpp
new file mode 100644
index 0000000..5097ed8
--- /dev/null
+++ b/tests/test_huge_page_arena.cpp
@@ -0,0 +1,176 @@
+/*
+ * test_huge_page_arena.cpp: tests for the books' huge-page arena (support/huge_page_arena.hpp).
+ *
+ * What it does: The arena hands out memory from its own region, which starts on a 2 MiB boundary
+ *   and is the request rounded up to 2 MiB. Asking for more than it holds throws instead of
+ *   falling back. DefaultResourceScope sets the default memory resource and puts the old one back.
+ *   A FastBook built in the arena takes exactly what arena_bytes() says (one fits, a second does
+ *   not), and still works. Every page was touched up front, so writing to it costs no page fault.
+ *   And a whole day's books built in the arena end exactly like books built normally (the golden
+ *   day and a busy day, compared stock by stock): the timed tools' books are the same books.
+ *
+ * Why it exists: Optimise design E6. The books' arrays must really land in the arena, and a wrong
+ *   size estimate must fail loudly: otherwise the timed runs would quietly use normal pages.
+ *
+ * Trade-offs: Whether the kernel gives 2 MiB pages depends on the machine (free memory, settings),
+ *   so huge_bytes() is only checked for being whole 2 MiB pages within the arena.
+ */
+
+#include <gtest/gtest.h>
+
+#include <cstddef>
+#include <cstdint>
+#include <memory_resource>
+#include <new>
+#include <optional>
+#include <vector>
+
+#include "huge_page_arena.hpp"
+#include "itch_golden_day.hpp"
+#include "itch_replay_comparison.hpp"
+#include "nanobook/itch/book_builder.hpp"
+#include "nanobook/itch/day_stats.hpp"
+#include "nanobook/itch/parser.hpp"
+#include "nanobook/itch/sizing.hpp"
+#include "nanobook/core/types.hpp"
+#include "nanobook/fast/fast_book.hpp"
+#include "page_faults.hpp"
+
+using nanobook::BookConfig;
+using nanobook::FastBook;
+using nanobook::support::DefaultResourceScope;
+using nanobook::support::HugePageArena;
+using nanobook::support::kHugePage;
+
+namespace {
+
+constexpr BookConfig kConfig{.min_price = nanobook::Price{1},
+                             .max_price = nanobook::Price{10'000},
+                             .max_orders = 10'000,
+                             .max_qty = nanobook::Qty{1'000'000}};
+
+} // namespace
+
+TEST(HugePageArena, HandsOutMemoryFromItsOwnAlignedRegion) {
+    HugePageArena arena{3 << 20U}; // 3 MiB, rounded up to 4
+    EXPECT_EQ(arena.size(), 2 * kHugePage);
+    void *first = arena.resource()->allocate(1'000, 8);
+    void *second = arena.resource()->allocate(1'000, 8);
+    EXPECT_TRUE(arena.contains(first));
+    EXPECT_TRUE(arena.contains(second));
+    EXPECT_EQ(reinterpret_cast<std::uintptr_t>(first) % kHugePage, 0U); // NOLINT: an address
+    EXPECT_EQ(arena.huge_bytes() % kHugePage, 0U);
+    EXPECT_LE(arena.huge_bytes(), arena.size());
+}
+
+TEST(HugePageArena, AskingForMoreThanItHoldsThrows) {
+    HugePageArena arena{kHugePage};
+    EXPECT_THROW((void)arena.resource()->allocate(kHugePage + 1, 8), std::bad_alloc);
+}
+
+TEST(HugePageArena, TheScopeSetsTheDefaultResourceAndPutsTheOldOneBack) {
+    HugePageArena arena{kHugePage};
+    std::pmr::memory_resource *before = std::pmr::get_default_resource();
+    {
+        const DefaultResourceScope scope{arena.resource()};
+        EXPECT_EQ(std::pmr::get_default_resource(), arena.resource());
+    }
+    EXPECT_EQ(std::pmr::get_default_resource(), before);
+}
+
+namespace {
+
+// Passes requests on to new/delete and adds up the bytes asked for.
+class CountingResource : public std::pmr::memory_resource {
+public:
+    std::size_t bytes{};
+
+private:
+    void *do_allocate(std::size_t n, std::size_t alignment) override {
+        bytes += n;
+        return std::pmr::new_delete_resource()->allocate(n, alignment);
+    }
+    void do_deallocate(void *p, std::size_t n, std::size_t alignment) override {
+        std::pmr::new_delete_resource()->deallocate(p, n, alignment);
+    }
+    [[nodiscard]] bool do_is_equal(const std::pmr::memory_resource &other) const noexcept override {
+        return this == &other;
+    }
+};
+
+} // namespace
+
+TEST(HugePageArena, ArenaBytesIsExactlyWhatABookAsksFor) {
+    for (const std::uint32_t max_orders : {1U, 10'000U, 123'457U}) {
+        BookConfig config = kConfig;
+        config.max_orders = max_orders;
+        CountingResource counting;
+        {
+            const DefaultResourceScope scope{&counting};
+            const FastBook book{config};
+        }
+        EXPECT_EQ(counting.bytes, FastBook::arena_bytes(config)) << max_orders;
+    }
+}
+
+TEST(HugePageArena, ABookTakesExactlyWhatArenaBytesSays) {
+    // One book fits in arena_bytes() plus the alignment allowance, and uses up its share: a second
+    // one doesn't fit, so the first really took its arrays from the arena.
+    HugePageArena arena{FastBook::arena_bytes(kConfig) + (std::size_t{4} * 64)};
+    const std::size_t spare = arena.size() - FastBook::arena_bytes(kConfig); // rounding to 2 MiB
+    ASSERT_LT(spare, FastBook::arena_bytes(kConfig)); // so a second book can't fit in the rest
+    std::optional<FastBook> book;
+    {
+        const DefaultResourceScope scope{arena.resource()};
+        book.emplace(kConfig);
+        EXPECT_THROW(FastBook{kConfig}, std::bad_alloc);
+    }
+    using nanobook::FeedAdd;
+    using nanobook::FeedResult;
+    using nanobook::OrderId;
+    using nanobook::Side;
+    EXPECT_EQ(book->apply(FeedAdd{.id = OrderId{7},
+                                  .side = Side::Buy,
+                                  .price = nanobook::Price{100},
+                                  .qty = nanobook::Qty{10}}),
+              FeedResult::Ok);
+    EXPECT_EQ(book->best_bid(), nanobook::Price{100});
+}
+
+TEST(HugePageArena, EveryPageIsTouchedUpFront) {
+    HugePageArena arena{kHugePage};
+    auto *bytes = static_cast<unsigned char *>(arena.resource()->allocate(kHugePage, 64));
+    const nanobook::latency::PageFaults before = nanobook::latency::page_faults_now();
+    volatile unsigned char *page = bytes;
+    for (std::size_t i = 0; i < kHugePage; i += 4096) {
+        page[i] = 1;
+    }
+    const nanobook::latency::PageFaults taken = nanobook::latency::page_faults_now() - before;
+    EXPECT_EQ(taken.minor, 0U); // 512 pages written; all were mapped when the arena was made
+}
+
+TEST(HugePageArena, ADaysBooksBuiltInItEndLikeBooksBuiltNormally) {
+    using namespace nanobook::itch;
+    using Builder = BookBuilder<FastBook>;
+    for (const auto &day : {golden::golden_day(), golden::busy_day(20'000)}) {
+        DayCounter counter;
+        ASSERT_TRUE(parse(day, counter).has_value());
+        const std::vector<BookConfig> configs =
+            size_books(counter.directory(), counter.stats(), SizingRules{});
+
+        Builder plain{configs, BuilderOptions{.check = true}};
+        HugePageArena arena{nanobook::support::arena_bytes(configs)};
+        auto in_arena =
+            nanobook::support::build_books<Builder>(arena, configs, BuilderOptions{.check = true});
+        ASSERT_TRUE(parse(day, plain).has_value());
+        ASSERT_TRUE(parse(day, in_arena).has_value());
+
+        EXPECT_EQ(in_arena.stats().results, plain.stats().results);
+        ASSERT_EQ(in_arena.locates(), plain.locates());
+        for (std::size_t i = 1; i < plain.locates(); ++i) {
+            const auto locate = static_cast<std::uint16_t>(i);
+            EXPECT_EQ(compare_books(in_arena.book(locate), plain.book(locate)), std::nullopt)
+                << locate;
+        }
+    }
+}

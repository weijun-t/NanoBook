+// E1d: a batched ring (HeadBatch > 1). Records become visible every HeadBatch pushes, when the
+// producer finds the ring full, or when it flushes; never earlier.
+TEST(SpscRing, ABatchedRingPublishesEveryBatch) {
+    SpscRing<int, 8, 2> ring; // the producer publishes its position every 2 pushes
+    int out = -1;
+    ASSERT_TRUE(ring.try_push(0));
+    EXPECT_FALSE(ring.try_pop(out)); // one push: not published yet
+    ASSERT_TRUE(ring.try_push(1));   // two: both published together
+    ASSERT_TRUE(ring.try_pop(out));
+    EXPECT_EQ(out, 0);
+    ASSERT_TRUE(ring.try_pop(out));
+    EXPECT_EQ(out, 1);
+}

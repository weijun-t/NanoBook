+// E1d: ring 2 publishes in batches of 64 updates, so the engine must flush it before it waits for
+// more records. The feed sends the first add, then waits (up to a deadline) until the publisher
+// has seen its update, then sends the rest. Without the flush that one update would sit unseen
+// while the engine waits, and the deadline would pass.
+TEST(Pipeline, AnUpdateReachesThePublisherWhileTheFeedWaits) {
+    const std::vector<std::byte> day = golden::golden_day();
+    std::size_t pos = 0;
+    for (int i = 0; i < 8; ++i) { // 7 messages before the first add, then the add
+        pos += 2 + std::to_integer<std::size_t>(day[pos + 1]); // the length's low byte (< 256)
+    }
+    const std::span<const std::byte> first{day.data(), pos};
+    const std::span<const std::byte> rest{day.data() + pos, day.size() - pos};
+    std::atomic<std::size_t> seen{0};
+    bool arrived = false; // written by the feed thread, read after the join
+    const auto read_feed = [&](auto &handler) {
+        const auto a = parse(first, handler);
+        const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds{10};
+        while (seen.load(std::memory_order_acquire) == 0 &&
+               std::chrono::steady_clock::now() < deadline) {
+            std::this_thread::yield();
+        }
+        arrived = seen.load(std::memory_order_acquire) > 0;
+        const auto b = parse(rest, handler);
+        return a.has_value() && *a == first.size() && b.has_value() && *b == rest.size();
+    };
+    auto sink = [&seen](const TopOfBook & /*unused*/) {
+        seen.fetch_add(1, std::memory_order_release);
+    };
+    Builder three{configs_for(day), BuilderOptions{}};
+    const PipelineResult result = run_pipeline(read_feed, three, sink, PipelineOptions{});
+    EXPECT_TRUE(arrived) << "the engine went idle without publishing its update";
+    EXPECT_TRUE(result.parsed);
+    EXPECT_EQ(result.updates, 16U); // as on the golden day in one go
+}

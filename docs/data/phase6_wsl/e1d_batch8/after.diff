+    EXPECT_FALSE(ring.try_pop(out)); // 4 pushes, fewer than 64: nothing published yet
+    EXPECT_FALSE(ring.try_push(4));  // finding it full publishes every record written...
+    for (int expected = 0; expected < 4; ++expected) {

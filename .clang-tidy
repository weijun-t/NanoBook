# .clang-tidy: static checks run on our code in CI.
#
# What it does: Turns on the bugprone, performance, modernize and concurrency check groups, plus a
#   few single checks, and treats every finding as an error. Third-party headers are not checked.

---
Checks: >
  -*,
  bugprone-*,
  performance-*,
  modernize-*,
  concurrency-*,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-pro-type-reinterpret-cast,
  readability-identifier-naming,
  -modernize-use-trailing-return-type

WarningsAsErrors: '*'

# Matched against the FULL path (/home/.../NanoBook/include/...), so no leading ^.
# Third-party headers (_deps/) are not matched and therefore not checked.
HeaderFilterRegex: '.*/(include/nanobook|src)/.*'

CheckOptions:
  - key:   readability-identifier-naming.NamespaceCase
    value: lower_case
...
